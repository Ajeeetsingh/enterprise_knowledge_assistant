# Copy to evaluation/.env and fill in values.
# Prefer KNOWRA_ACCESS_TOKEN if you already have a JWT from the UI/login.

# Base URL must include /api/v1 (same as frontend VITE_API_BASE_URL).
KNOWRA_API_BASE_URL=http://localhost:8000/api/v1

# Auth option A: paste a Bearer access token
KNOWRA_ACCESS_TOKEN=

# Auth option B: login with credentials (used when ACCESS_TOKEN is empty)
KNOWRA_EMAIL=admin@example.com
KNOWRA_PASSWORD=change-me

# Request behaviour
KNOWRA_REQUEST_TIMEOUT=120
# Stay under backend chat-ask rate limit (30 requests / 60s).
KNOWRA_REQUEST_DELAY_SECONDS=2.1
# true = fresh conversation per question (recommended for clean evals)
KNOWRA_CREATE_CONVERSATION_PER_QUESTION=true
KNOWRA_CONVERSATION_TITLE_PREFIX=Knowra Evaluation
