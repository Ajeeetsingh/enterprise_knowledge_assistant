###################################################
# Application
###################################################
APP_NAME=Knowra
# development | staging | production
# Outside development, JWT_SECRET must NOT be the placeholder below.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Single-tenant identifier (MVP)
TENANT_ID=default
# Tenant branding / routing aliases (comma-separated). Used for DOCUMENT routing
# and (later) grounded prompts — do not hardcode customer names in application code.
# Example: ORG_DISPLAY_NAME=Acme Corporation
#          ORG_ALIASES=Acme Corporation,Acme,ACME
ORG_DISPLAY_NAME=
ORG_ALIASES=
# Temporary Phase-1 acceptance diagnostics for routing/RAG.
ROUTING_DEBUG_LOGGING=true
# Phase-2B: full retrieval diagnostics (writes storage/diagnostics/*.txt + *.json).
RAG_DIAGNOSTICS_ENABLED=true

###################################################
# Database
###################################################
# Local (host Python talking to Docker Postgres published on 5432):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eka
# Docker Compose backend service overrides this to use host "postgres".

###################################################
# Auth / JWT
###################################################
# Generate a long random value for any public deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

###################################################
# CORS (browser origins allowed to call the API)
###################################################
# JSON list. Override for your deployed frontend origin(s).
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.example"]

###################################################
# LLM (answer generation)
###################################################
# Provider: groq | openai | gemini | ollama | none
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_ENABLED=true

GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

###################################################
# Embeddings / retrieval models
###################################################
# Set true when models are pre-cached offline (skips Hugging Face hub checks).
EMBEDDING_LOCAL_ONLY=false

# Hybrid retrieval
HYBRID_ENABLED=true
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=5

# Cross-encoder reranking
RERANKING_ENABLED=true
RERANK_TOP_N=20
RERANK_MODEL=ms-marco-minilm-l6-v2

# Query intelligence
QUERY_INTELLIGENCE_ENABLED=true

###################################################
# Knowledge Intelligence Engine (Phase 13.1)
###################################################
# Shadow Mode: generate DocumentKnowledge in parallel with legacy ingestion.
# Does not change API/retrieval/frontend behavior. Fail-open on errors.
KNOWLEDGE_ENGINE_SHADOW_ENABLED=true
# Optional LLM enrichment for summaries (default off — heuristic path is default).
KNOWLEDGE_ENGINE_LLM_ENRICHMENT_ENABLED=false

# Knowledge Registry (Phase 13.2) — organize Knowledge Objects in Shadow Mode.
KNOWLEDGE_REGISTRY_SHADOW_ENABLED=true

# Knowledge Relationship Engine (Phase 13.3) — discover relationships in Shadow Mode.
KNOWLEDGE_RELATIONSHIP_SHADOW_ENABLED=true

# Hybrid Knowledge Index (Phase 13.4) — Shadow Mode only.
# Indexes KO + Registry + Relationships. Not consumed by production retrieval.
KNOWLEDGE_INDEX_SHADOW_ENABLED=true

# Intelligent Query Planner (Phase 13.5) — Shadow Mode only.
# Builds execution plans for queries. Never influences production retrieval.
QUERY_PLANNER_SHADOW_ENABLED=true

# Knowledge Execution Engine (Phase 13.6) — Shadow Mode only.
# Executes QueryExecutionPlans against Hybrid Indexes. Not consumed by production.
KNOWLEDGE_EXECUTION_SHADOW_ENABLED=true

# Knowledge Graph (Phase 13.7) — Shadow Mode only.
# Graph traversal/expansion. Not consumed by production retrieval.
KNOWLEDGE_GRAPH_SHADOW_ENABLED=true

# Worker Orchestration (Phase 13.8) — Shadow Mode only.
# Coordinates workers wrapping existing providers. Not an AI agent runtime.
KNOWLEDGE_ORCHESTRATION_SHADOW_ENABLED=true

###################################################
# Production Docker Compose helpers (docker-compose.prod.yml)
###################################################
# POSTGRES_DB=eka
# POSTGRES_USER=eka
# POSTGRES_PASSWORD=replace-with-strong-password
# BACKEND_HOST_PORT=8000

###################################################
# Advanced ingestion / retrieval tuning
# (defaults are production-safe; override only when needed)
###################################################
# See docs/ARCHITECTURE.md for the full pipeline. Common knobs live in
# backend/app/config.py and can be set via environment variables with the
# same names uppercased (e.g. METADATA_RETRIEVAL_ENABLED=true).
