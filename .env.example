###################################################
# Application
###################################################
APP_NAME=Knowra
# development | staging | production
# Outside development, JWT_SECRET must NOT be the placeholder below.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Single-tenant identifier (MVP)
TENANT_ID=default

###################################################
# Database
###################################################
# Local (host Python talking to Docker Postgres published on 5432):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eka
# Docker Compose backend service overrides this to use host "postgres".

###################################################
# Auth / JWT
###################################################
# Generate a long random value for any public deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

###################################################
# CORS (browser origins allowed to call the API)
###################################################
# JSON list. Override for your deployed frontend origin(s).
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.example"]

###################################################
# LLM (answer generation)
###################################################
# Provider: groq | openai | gemini | ollama | none
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_ENABLED=true

GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

###################################################
# Embeddings / retrieval models
###################################################
# Set true when models are pre-cached offline (skips Hugging Face hub checks).
EMBEDDING_LOCAL_ONLY=false

# Hybrid retrieval
HYBRID_ENABLED=true
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=5

# Cross-encoder reranking
RERANKING_ENABLED=true
RERANK_TOP_N=20
RERANK_MODEL=ms-marco-minilm-l6-v2

# Query intelligence
QUERY_INTELLIGENCE_ENABLED=true

###################################################
# Production Docker Compose helpers (docker-compose.prod.yml)
###################################################
# POSTGRES_DB=eka
# POSTGRES_USER=eka
# POSTGRES_PASSWORD=replace-with-strong-password
# BACKEND_HOST_PORT=8000

###################################################
# Advanced ingestion / retrieval tuning
# (defaults are production-safe; override only when needed)
###################################################
# See docs/ARCHITECTURE.md for the full pipeline. Common knobs live in
# backend/app/config.py and can be set via environment variables with the
# same names uppercased (e.g. METADATA_RETRIEVAL_ENABLED=true).
