APP_NAME=Enterprise Knowledge Assistant
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/eka

# Embeddings — set true when models are pre-cached (skips HF hub checks)
EMBEDDING_LOCAL_ONLY=false

###################################################
# LLM Configuration
###################################################

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

GROQ_API_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

LLM_FALLBACK_ENABLED=true

# JWT (Phase 2 — authentication subsystem)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

###################################################
# Document Normalization (Phase 12.3A)
###################################################

NORMALIZATION_ENABLE_BOILERPLATE_REMOVAL=true
NORMALIZATION_ENABLE_UNICODE_CLEANUP=true
NORMALIZATION_ENABLE_OCR_CLEANUP=true
NORMALIZATION_MINIMUM_HEADER_FREQUENCY=2
NORMALIZATION_MINIMUM_FOOTER_FREQUENCY=2
NORMALIZATION_MAXIMUM_HEADER_LINES=4
NORMALIZATION_MAXIMUM_FOOTER_LINES=3
NORMALIZATION_BOILERPLATE_MIN_PAGE_RATIO=0.4

###################################################
# Document Structure Extraction (Phase 12.3B)
###################################################

STRUCTURE_EXTRACTION_ENABLED=true
STRUCTURE_MAX_HEADING_LENGTH=200
STRUCTURE_MIN_TABLE_COLUMNS=2
STRUCTURE_MIN_TABLE_ROWS=2
STRUCTURE_MAX_TABLE_COLUMNS=6
STRUCTURE_MAX_STACKED_TABLE_ROWS=25
STRUCTURE_TABLE_COLUMN_GAP_SPACES=2
STRUCTURE_TABLE_CONFIDENCE_THRESHOLD=0.55
STRUCTURE_MAX_LIST_NESTING_DEPTH=6

###################################################
# Semantic Chunk Generation (Phase 12.4)
###################################################

SEMANTIC_MAX_PREFERRED_CHUNK_SIZE=1200
SEMANTIC_MIN_CHUNK_SIZE=80
SEMANTIC_SOFT_MAX_CHUNK_SIZE=1500
SEMANTIC_ABSOLUTE_MAX_CHUNK_SIZE=1800
SEMANTIC_MAX_TABLE_CHUNK_SIZE=1800
SEMANTIC_MAX_PARAGRAPH_MERGE=2
SEMANTIC_SECTION_MERGE_THRESHOLD=1800
SEMANTIC_OVERLAP_ENABLED=true
SEMANTIC_INCLUDE_HIERARCHY_IN_OVERLAP=true

# Metadata-aware retrieval (Phase 12.5)
METADATA_RETRIEVAL_ENABLED=true
METADATA_CANDIDATE_MULTIPLIER=15
METADATA_MAX_BONUS=0.15
METADATA_HEADING_SIMILARITY_WEIGHT=0.04
METADATA_SECTION_TITLE_SIMILARITY_WEIGHT=0.05
METADATA_HIERARCHY_SIMILARITY_WEIGHT=0.03
METADATA_CHUNK_TYPE_MATCH_WEIGHT=0.04
METADATA_TABLE_INTENT_BOOST=0.05
METADATA_LIST_INTENT_BOOST=0.05
METADATA_SECTION_HEADER_INTENT_BOOST=0.04
METADATA_PARAGRAPH_INTENT_BOOST=0.04
METADATA_NUMERIC_INTENT_BOOST=0.03
METADATA_SECTION_CONTINUITY_WEIGHT=0.03
METADATA_DOCUMENT_CONTINUITY_WEIGHT=0.02
METADATA_READING_ORDER_CONTINUITY_WEIGHT=0.02

# Hybrid retrieval (Phase 12.7)
HYBRID_ENABLED=true
SPARSE_WEIGHT=1.0
DENSE_WEIGHT=1.0
RRF_K=60
BM25_K1=1.5
BM25_B=0.75
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=5
HYBRID_STEMMING_ENABLED=false
HYBRID_STOPWORDS_ENABLED=true

# Cross-encoder reranking (Phase 12.8)
RERANKING_ENABLED=true
RERANK_TOP_N=20
RERANK_MODEL=ms-marco-minilm-l6-v2
RERANK_MAX_BATCH_SIZE=16
RERANK_MAX_SEQUENCE_LENGTH=512

# Query intelligence (Phase 12.9)
QUERY_INTELLIGENCE_ENABLED=true
QUERY_EXPANSION_ENABLED=true
MULTI_QUERY_ENABLED=true
MAX_GENERATED_QUERIES=4
ENTITY_NORMALIZATION_ENABLED=true
SYNONYM_EXPANSION_ENABLED=true
STRATEGY_SELECTION_ENABLED=true
