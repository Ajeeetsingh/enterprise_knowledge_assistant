# ==================================================
# Environment / Secrets
# Never commit real credentials
# ==================================================

.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local

!.env.example
!frontend/.env.example
!evaluation/.env.example

# Standalone evaluation utility secrets (evaluation/ source is committable)
evaluation/.env

