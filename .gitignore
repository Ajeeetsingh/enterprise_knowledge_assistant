*.log
logs/

# ==================================================
# Runtime Uploads & Search Indexes
# ==================================================

backend/storage/documents/*
!backend/storage/documents/.gitkeep

backend/storage/indexes/*
!backend/storage/indexes/.gitkeep

# Generated RAG diagnostic dumps (never commit)
backend/storage/diagnostics/

# Accidental nested storage when STORAGE_PATH=./backend/storage and cwd=backend/
backend/backend/

# Local-only evaluation/test data (entire tree — do not commit)
docs/test_docs/

backend/evaluation_storage/
backend/trace_output.txt

# ==================================================
# Evaluation / Benchmark Outputs
# ==================================================

results/
data/
# Frontend seed data is source code, not local-only output
!frontend/src/features/admin/collections/data/

backend/evaluation_results/
backend/benchmark_results/

