# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Node / frontend
node_modules/
dist/
build/
frontend/dist/
node_modules/.vite/

# Environment / secrets — never commit real credentials
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
!.env.example
!frontend/.env.example

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Runtime uploads & search indexes (persist locally / in Docker volumes)
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/indexes/*
!backend/storage/indexes/.gitkeep
backend/evaluation_storage/
backend/trace_output.txt

# Evaluation / benchmark outputs (keep fixtures under backend/tests)
results/
data/
backend/evaluation_results/
backend/benchmark_results/

# Model caches (Hugging Face / SentenceTransformers)
.cache/
**/huggingface/
**/sentence-transformers/

# Docker
*.pid
